# systemd user service. Install:
#   install -Dm755 target/release/quietmouse ~/.local/bin/quietmouse
#   install -Dm644 packaging/linux/quietmouse.service ~/.config/systemd/user/quietmouse.service
#   systemctl --user enable --now quietmouse

[Unit]
Description=quietmouse: Logitech mouse settings, buttons and gestures
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/quietmouse run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
